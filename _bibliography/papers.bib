@book {MR2713910,
bibtex_show = {true},
    AUTHOR = {Zhang, Ziyu},
     TITLE = {On singular moduli spaces of sheaves on {K}3 surfaces},
      NOTE = {Thesis (Ph.D.)--Stanford University},
 PUBLISHER = {ProQuest LLC, Ann Arbor, MI},
      YEAR = {2009},
     PAGES = {73},
      ISBN = {978-1109-44707-1},
   MRCLASS = {Thesis},
  MRNUMBER = {2713910},
       URL = {http://gateway.proquest.com/openurl?url_ver=Z39.88-2004&rft_val_fmt=info:ofi/fmt:kev:mtx:dissertation&res_dat=xri:pqdiss&rft_dat=xri:pqdiss:3382927},
abstract={After reviewing the fundamentals on moduli spaces of sheaves on K3 surfaces, local structures and global properties of singular moduli spaces are studied. Generalizing Lehn and Sorger's theorem, we prove that when divisibility of Mukai vector is at most 3, every singular point in the moduli space has an analytic open neighborhood that is a quotient of a quadratic singularity by the stabilizer group of this point. Generalizing Yoshioka's theorem, we prove that when the greatest common divisor of the rank and first Chern class is 2, two moduli spaces of identical dimensions can be connected by deformations and birational maps.},
html={https://www.proquest.com/dissertations-theses/on-singular-moduli-spaces-sheaves-k3-surfaces/docview/304999373/se-2?accountid=178621},
}



